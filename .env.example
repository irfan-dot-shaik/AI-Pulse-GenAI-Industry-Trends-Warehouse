# =============================================================================
# .env.example — AI Pulse Project
# =============================================================================
# PURPOSE: This is a TEMPLATE showing all environment variables the project needs.
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in the new .env file
#   3. NEVER commit the .env file (it's in .gitignore)
#
# WHY ENVIRONMENT VARIABLES?
#   Hardcoding secrets in Python files is dangerous.
#   If you push your code to GitHub, everyone can see your API keys.
#   Environment variables keep secrets out of your code.
# =============================================================================


# --- GNews API ---
# Get your free API key at: https://gnews.io
# Free tier: 100 requests/day, up to 10 articles per request
GNEWS_API_KEY=your_gnews_api_key_here


# --- GNews Query Settings ---
# The search keyword for fetching AI-related articles
GNEWS_QUERY=artificial intelligence OR generative AI OR OpenAI OR Google Gemini OR Anthropic

# Number of articles to fetch per API call (max 10 on free tier)
GNEWS_MAX_RESULTS=10

# Language of articles to fetch
GNEWS_LANGUAGE=en

# Country filter (us = United States)
GNEWS_COUNTRY=us


# --- PostgreSQL Database ---
# The full database connection URL used by SQLAlchemy
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pulse_db

# You can also set individual components if preferred
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_pulse_db
DB_USER=postgres
DB_PASSWORD=postgres


# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG during development, INFO in production
LOG_LEVEL=INFO


# =============================================================================
# Week 3 — Multi-Source Ingestion
# =============================================================================

# --- Reddit API (OPTIONAL) ---
# If not set, Reddit ingestion is silently skipped. GNews + HN still run.
# How to get credentials (free, <2 minutes):
#   1. Go to https://www.reddit.com/prefs/apps
#   2. Click "Create App" → choose type: "script"
#   3. Fill in a name and redirect URI (http://localhost is fine)
#   4. Copy the client_id (under the app name) and client_secret
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ai_pulse_bot/1.0 by AI_Pulse_Project

# Subreddits to scrape (comma-separated, no "r/" prefix)
REDDIT_SUBREDDITS=MachineLearning,artificial,singularity

# Hot posts to fetch per subreddit
REDDIT_POST_LIMIT=10


# --- Hacker News (NO CREDENTIALS NEEDED) ---
# HN uses a public Firebase REST API — completely free and unlimited.
# These settings control how many stories are inspected and returned.

# How many unique story IDs to inspect across top/best/new feeds
HN_INSPECT_LIMIT=100

# How many AI-relevant stories to return per pipeline run
HN_FETCH_LIMIT=10
